{
  "name": "jsjs",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "npm run vendor:sync && npm run test:node && npm run test262:fixtures",
    "test:node": "node test/run-node.js",
    "test:browser": "npm run vendor:sync && node test/run-browser-playwright.js",
    "test:jsc": "npm run vendor:sync && jsc -m test/run-jsc.js",
    "test262:fixtures": "node tools/test262/adapters/node.js --root=test/fixtures/test262 --features=fixture-subset",
    "test262:jsc": "npm run vendor:sync && jsc -m tools/test262/adapters/jsc-run.js",
    "vendor:sync": "node tools/vendor/sync.js",
    "vendor:check": "node tools/vendor/sync.js --check",
    "prepare": "node tools/vendor/sync.js",
    "typecheck": "tsc -p jsconfig.json",
    "lint": "ESLINT_USE_FLAT_CONFIG=true eslint . && prettier --check package.json jsconfig.json eslint.config.js .prettierrc.json src/parser-dependency.js test/*.js test/harness/*.js test/node/*.js tools/test262/*.js tools/test262/adapters/*.js tools/vendor/*.js types/*.d.ts"
  },
  "test262": {
    "repository": "https://github.com/tc39/test262.git",
    "revision": "b363f29d3c43c626dc852744ad64a0b48a003693",
    "revisionDate": "2026-07-31",
    "checkoutPath": "vendor/test262"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "playwright": "^1.62.1",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "acorn": "8.18.0"
  }
}
