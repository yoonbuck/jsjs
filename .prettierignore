# `npm run format` checks the whole repository, so what stays out of the check
# is listed here rather than encoded as an allowlist of paths in the script:
# every project source file is checked unless one of these owns its bytes.
# `test/node/repository-invariants.test.js` fails if this list grows an entry
# that is neither generated nor guest-owned — dropping `src/` in here is the
# quiet way to stop formatting the engine.

# Installed dependencies, not project source.
node_modules/

# Generated by tools/vendor/sync.js from the pinned dependencies.
vendor/

# Local working notes, not project source.
.superpowers/

# Test262 fixtures are guest scripts, and some are deliberately unparseable.
test/fixtures/

# Generated by npm, which owns its bytes.
package-lock.json

# Generated by tools/ci/pipeline.js, whose byte-for-byte output ci:check owns.
.github/workflows/

# Generated by npm run test262:upstream, whose JSON lines own their bytes.
docs/test262-report.jsonl

# Generated immutable provenance foundation; canonical bytes are owned by the deterministic provenance generator/check.
tools/test262/es2015-provenance.json

# Generated by the pinned ES2015 audit, whose byte-for-byte output it owns.
tools/test262/es2015-taxonomy.json

# Generated immutable promotion evidence, whose intentional formatting it owns.
tools/test262/es2015-promotion.json

# Generated H0 disposition evidence, whose canonical bytes are owned by the
# pinned ES2015 audit.
tools/test262/es2015-h0-disposition.json

# Generated H0 owner-delta evidence, whose canonical bytes are owned by the
# pinned ES2015 audit.
tools/test262/es2015-h0-owner-deltas.json

# Generated H0 promotion evidence, whose canonical bytes are owned by the
# pinned ES2015 audit.
tools/test262/es2015-h0-promotion.json

