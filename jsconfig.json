{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "target": "ES2020",
    "module": "ES2022",
    "moduleResolution": "Node",
    "maxNodeModuleJsDepth": 0,
    "lib": ["ES2020", "DOM"],
    "skipLibCheck": true
  },
  "include": ["**/*.js", "**/*.d.ts"],
  "exclude": ["node_modules", "vendor", "dist", "test/fixtures"]
}
